# low (laptop, default) or normal (bigger machine)
RESOURCE_PROFILE=low
# Monitored markets. low: 20 by default, max 50. normal: 50, max 200.
MAX_MARKETS=
# Set to require a bearer token on the API and WebSocket (needed if you expose the ports beyond localhost)
API_TOKEN=
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=3
# Host ports (bound to 127.0.0.1)
FRONTEND_PORT=3000
BACKEND_PORT=8000
